# .env.local.example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. NEVER expose in client bundle.
# Find in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (no trailing slash). Used for share links + QR.
NEXT_PUBLIC_SITE_URL=https://ingegno.app

# ── Resend (email de bienvenida) ───────────────────────────────────────────────
# API key en: resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# ⚠️ IMPORTANTE: si EMAIL_FROM no está definida, lib/email.ts cae al dominio de
# pruebas de Resend (onboarding@resend.dev), que SOLO puede enviar a la dirección
# del dueño de la cuenta. Los registros reales no recibirían nada, y el fallo es
# silencioso (el error se captura y solo se loguea).
# El dominio debe estar verificado en Resend con sus registros SPF y DKIM.
EMAIL_FROM=Raúl from Ingegno <raul@ingegno.app>

# Dirección a la que llegan las respuestas de los usuarios.
EMAIL_REPLY_TO=rcalvosanz@gmail.com

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/github/callback (dev)
#                             https://ingegno.app/api/github/callback (prod)
# client_id is public (NEXT_PUBLIC_) — used in client-side redirect
# client_secret is server-only — never prefix with NEXT_PUBLIC_
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
